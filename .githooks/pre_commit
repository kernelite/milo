#!/bin/bash
set -e

echo "🔍 [Pre-Commit] Running incremental C++ code quality checks..."

STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMR || true)
STAGED_CPP=$(printf '%s\n' "$STAGED_ALL" | grep -E '\.(cpp|hpp|c|h)$' || true)
STAGED_BUILD=$(printf '%s\n' "$STAGED_ALL" | grep -E '^(Makefile|.*\.mk|scripts/generate_compile_commands\.py)$' || true)

if [ -n "$STAGED_BUILD" ] || [ ! -f "compile_commands.json" ]; then
    make compile_commands.json --quiet
fi

if [ -z "$STAGED_CPP" ]; then
    echo "✅ [Pre-Commit] No staged C/C++ files; skipping clang-format and clang-tidy."
    exit 0
fi

# Check formatting on staged C/C++ files first for fast feedback
FOR_FORMAT_FAIL=0
while IFS= read -r FILE; do
    [ -z "$FILE" ] && continue
    if ! clang-format --dry-run --Werror "$FILE" > /dev/null 2>&1; then
        echo "❌ Formatting violation in: $FILE"
        FOR_FORMAT_FAIL=1
    fi
done <<< "$STAGED_CPP"

if [ "$FOR_FORMAT_FAIL" -eq 1 ]; then
    echo ""
    echo "💡 Fix formatting by running: clang-format -i <file>"
    echo "   Or auto-format all files with: make format"
    exit 1
fi

# Run parallel clang-tidy only on staged C/C++ files (and TUs including staged headers)
mapfile -t CPP_ARRAY <<< "$STAGED_CPP"
python3 scripts/generate_quality_report.py --staged "${CPP_ARRAY[@]}"

echo "✅ [Pre-Commit] All quality checks passed!"