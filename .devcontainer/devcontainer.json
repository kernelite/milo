{
  "name": "Arm64 Microkernel Dev Environment",
"build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.makefile-tools",
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack"
      ],
      "settings": {
        "git.path": "/usr/bin/git",
        "git.enabled": true,
        "git.autoRepositoryDetection": true,
        "makefile.autoGenerate": true,
        "makefile.configurationTarget": "all",
        "makefile.makePath": "/usr/bin/make",
        "C_Cpp.default.cppStandard": "c++20",
        "C_Cpp.default.cStandard": "c17",
        "C_Cpp.default.compilerPath": "/usr/bin/aarch64-linux-gnu-g++",
        "C_Cpp.default.intelliSenseMode": "linux-gcc-arm64",
        "C_Cpp.default.includePath": [
          "${workspaceFolder}",
          "${workspaceFolder}/kernel",
          "${workspaceFolder}/arch/aarch64-linux-gnu"
        ],
        "C_Cpp.codeAnalysis.runAutomatically": true,
        "C_Cpp.codeAnalysis.clangTidy.enabled": true,
        "C_Cpp.codeAnalysis.clangTidy.path": "/usr/bin/clang-tidy"
      }
    }
  },
  "remoteUser": "vscode"
}
